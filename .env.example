# Copy to .env and fill in as needed. The daemon (custodian serve), the adapter (custodian mcp),
# and eval all read this repo's single .env.
# (The engine has been folded into this repo, so there's no second fallback .env anymore; all
# configuration lives under the unified CUSTODIAN_* namespace.)

# --- Identity (ACL, fail-closed: with no CUSTODIAN_TENANT set, every retrieval returns empty) ---
# The ~/rag_real sample index was built with tenant=demo / visibility=public, so demo is the default.
CUSTODIAN_TENANT=demo
CUSTODIAN_PRINCIPALS=

# --- Index location (defaults to ~/rag_real, produced by `custodian index`) ---
# CUSTODIAN_INDEX_DIR=~/rag_real
# CUSTODIAN_COLLECTION=real
# CUSTODIAN_DENSE_DIM=1024
# CUSTODIAN_QDRANT_PATH=      # Optional: override individually (defaults to <INDEX_DIR>/qdrant)
# CUSTODIAN_SIDECAR_DIR=      # Optional: override individually (defaults to <INDEX_DIR>/sidecar)

# --- GPU / local models (dense embedder + reranker; default ~/models, must include the official scripts/) ---
# CUSTODIAN_DENSE_MODEL_PATH=~/models/Qwen3-VL-Embedding-8B
# CUSTODIAN_RERANK_MODEL_PATH=~/models/Qwen3-VL-Reranker-8B
# CUSTODIAN_GPU_NAME=4090     # torch device 0's card name must contain this string (guards against drifting onto the wrong card); change this when you swap cards, leave empty to skip the check

# --- Ingestion / parsing (custodian index / custodian parse) ---
# CUSTODIAN_CORPUS_DIR=       # MinerU parse output directory (kept outside the repo); custodian index reads from here by default
# MINERU_TOKEN_A=          # MinerU parse API token (used by custodian parse; multiple can be rotated via _A/_B/_C)
# MINERU_TOKEN_B=
# MINERU_TOKEN_C=

# --- Service ---
# CUSTODIAN_HOST=127.0.0.1
# CUSTODIAN_PORT=8787
# CUSTODIAN_API_KEY=          # legacy single-key mode (a single-user doorstop); ignored in keys mode
# CUSTODIAN_KEYS_FILE=        # keys mode (team deployment): path to a JSON file (e.g. ~/custodian.keys.json).
#                          # Generate with `custodian keys new <name> --tenant demo`; chmod 600, never commit it.
# CUSTODIAN_SMART_ASK=on      # /v1/ask's smart-ask layer (numeric-question table re-retrieval + refusal hints); off = plain mode
# CUSTODIAN_MAX_CONTEXT_TOKENS=12000   # soft token cap on what a single retrieval call delivers

# --- Observability ---
# CUSTODIAN_LOG_DIR=~/custodian_logs   # request log directory (JSONL); empty = off
# CUSTODIAN_LOG_QUERIES=on          # whether logs include the query text (truncated to 120 chars); off = query content not recorded

# --- LLM (used by the closed-pipeline /v1/ask) ---
# DEEPSEEK_API_KEY=
# CUSTODIAN_LLM_BASE_URL=https://api.deepseek.com
# CUSTODIAN_LLM_MODEL=deepseek-v4-flash
# CUSTODIAN_LLM_MAX_TOKENS=2000
# CUSTODIAN_LLM_API_KEY_ENV=DEEPSEEK_API_KEY   # which environment variable to read the key from (change this when switching backends)

# --- MCP thin adapter / CLI (used to connect to the daemon) ---
# CUSTODIAN_URL=http://127.0.0.1:8787

# --- eval (five-metric evaluation; see eval/README for details) ---
# CUSTODIAN_EVAL_SRC=~/rag_eval_big              # eval corpus path (separate from the production ~/rag_real)
# CUSTODIAN_EVAL_COLLECTION=evalbig
# CUSTODIAN_EVAL_GEN_MODEL=deepseek-v4-flash     # must match CUSTODIAN_LLM_MODEL (this is testing the deployed configuration)
# CUSTODIAN_EVAL_JUDGE_MODEL=deepseek-v4-flash
