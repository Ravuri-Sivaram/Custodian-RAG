# .env.compose.example — the host-binding template for the Phase E compose deployment.
# Usage: cp .env.compose.example .env.compose, then fill in the values below (.env.compose is
# already in .gitignore — anything containing secrets must never be committed).
# Start with: docker compose --env-file .env.compose up -d --build
#
# WARNING: every path must be on WSL ext4 (run `realpath ~/xxx` inside WSL) -- NEVER /mnt/c/...
# (loading the 8B model degrades from taking a minute to taking over ten minutes there, which gets
# treated as a hang).

# The model directory (containing the Qwen3-VL-Embedding-8B / Qwen3-VL-Reranker-8B subdirectories).
# Mounted read-only into inference's /root/models.
MODELS_HOST_DIR=/home/<you>/models          # = realpath ~/models

# The index data root (contains the sidecar/ subdirectory; shared across replicas. Qdrant's
# vectors go through a named volume; this only holds sidecar + custodian_logs).
INDEX_HOST_DIR=/home/<you>/rag_real          # = realpath ~/rag_real

# The keys identity table (plaintext keys, never committed; mounted read-only into the container
# at /run/custodian/keys.json separately -- per the security review, this must not sit on the
# read-write data volume above).
# Generate with: cd custodian && PYTHONPATH=src python -m custodian keys new demo --tenant demo --file ~/custodian.keys.json
KEYS_HOST_FILE=/home/<you>/custodian.keys.json  # keep it OUTSIDE the data root, isolated from sidecar/logs

# The 4090's UUID -- pins it so FASTEST_FIRST selection can't drift onto a 5070. To get it (inside
# WSL): nvidia-smi -L, then copy the GPU-... string in parentheses on the 4090's line.
GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ACL identity (fail-closed: empty means every retrieval returns empty) + collection + dimension
CUSTODIAN_TENANT=demo
CUSTODIAN_COLLECTION=real
CUSTODIAN_DENSE_DIM=1024

# The LLM used by /v1/ask (generator reads llm_api_key_env from config.py, defaulting to
# DEEPSEEK_API_KEY). Not baked into the image -- injected only at runtime.
DEEPSEEK_API_KEY=sk-...
CUSTODIAN_LLM_MODEL=deepseek-v4-flash

# ── Phase F tuning (all optional; leave blank to use the defaults) ──
# The entry point is nginx: http://127.0.0.1:8080 (custodian replicas don't publish a host port,
# so --scale custodian=N has no port conflict).
# Inference backpressure: the cap on requests in flight at once (GPU forward passes are
# serialized; once full, it returns 503 overloaded so the client backs off). Tune from load-test
# throughput.
INFERENCE_MAX_INFLIGHT=16
# Warm-up transient-failure retry count (once exhausted, it calls os._exit(1) so
# restart:unless-stopped brings it back up on its own; a permanent configuration error does not
# trigger a self-kill).
INFERENCE_WARMUP_RETRIES=3
# The remote client's failure-mode tuning (for custodian replicas; defaults to 120s/3s/2/0.5 if
# unset). Useful for tuning retries/backoff from a Phase F load test without touching code and
# rebuilding the image:
# CUSTODIAN_INFERENCE_TIMEOUT=120
# CUSTODIAN_INFERENCE_CONNECT_TIMEOUT=3
# CUSTODIAN_INFERENCE_RETRIES=2
# CUSTODIAN_INFERENCE_BACKOFF=0.5
