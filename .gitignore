# Secrets and local config (never commit)
.env
.env.compose

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/

# Local index / temporary artifacts
*.local/

# Team edition: key files and request logs (never check in)
*.keys.json
