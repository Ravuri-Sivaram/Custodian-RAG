{
  "mcpServers": {
    "rag": {
      "command": "wsl",
      "args": ["bash", "-lc",
        "source <PATH_TO_MINICONDA>/etc/profile.d/conda.sh && conda activate <CONDA_ENV> && cd <PATH_TO>/custodian && CUSTODIAN_URL=http://127.0.0.1:8787 CUSTODIAN_API_KEY=<YOUR_API_KEY> python -m custodian mcp"]
    }
  }
}
